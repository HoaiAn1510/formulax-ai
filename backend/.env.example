# Lấy Gemini API key tại: https://aistudio.google.com/app/apikey
# Từ 2026-10-30 key này dùng cho CẢ AI Finder lẫn đọc ảnh đề. Hạn mức tính riêng từng model và theo dự án.
GEMINI_API_KEY=

# (Tuỳ chọn, đặt trên Render) model và mức suy nghĩ của AI Finder — không đặt thì dùng mặc định trong
# lib/finderPrompt.js / lib/geminiChat.js. Đổi ở đây khi model bị 503 hoặc hết hạn mức.
FINDER_GEMINI_MODEL=
FINDER_GEMINI_FALLBACK_MODEL=
FINDER_GEMINI_THINKING_LEVEL=

# Key Groq cũ — AI Finder không còn dùng. Chỉ cần nếu chạy lại script chấm bằng Groq.
GROQ_API_KEY=

# Key Groq ở TÀI KHOẢN RIÊNG, chỉ dùng cho script chấm / thử nghiệm model (không dùng ở production).
# Script chấm thiếu biến này thì dừng — không bao giờ chấm bằng GROQ_API_KEY vì hạn mức token/ngày
# của gói miễn phí dùng chung với học sinh thật. Không cần đặt biến này trên Render.
GROQ_EVAL_API_KEY=

# Key Gemini ở DỰ ÁN RIÊNG, chỉ cho scripts/finder-live-check.mjs. Thiếu biến này thì script dừng
# (không dùng GEMINI_API_KEY của production — hạn mức dùng chung với học sinh thật).
GEMINI_EVAL_API_KEY=

# Port cho backend server (mặc định: 3001)
PORT=3001

# Môi trường chạy. BẮT BUỘC đặt NODE_ENV=production khi deploy (Render → Environment):
# ở production các route DEV (/payos/simulate-success, /payos/payment-status) và trang test
# public/simulate-payment.html bị khoá trả 404. Để trống = development = các route đó mở.
NODE_ENV=development

# URL frontend (dùng cho CORS + redirect sau khi thanh toán)
FRONTEND_URL=http://localhost:5173

# URL công khai của backend — PayOS webhook cần URL này để gọi ngược về (ngrok/Render)
BACKEND_PUBLIC_URL=http://localhost:3001

# Supabase — service role key (KHÔNG phải anon key), lấy tại Project Settings → API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email được xem GET /api/admin/channel-stats (thống kê kênh giới thiệu), cách nhau bằng dấu phẩy.
# Để trống = không ai xem được.
ADMIN_EMAILS=

# PayOS — lấy tại https://payos.vn (mục Kênh thanh toán → Thông tin kết nối)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Khoá bảo vệ route POST /api/payment/payos/simulate-success (test thủ công không cần chuyển khoản thật)
# Chỉ có tác dụng khi NODE_ENV != production. Bỏ trống hoặc xoá dòng này để khoá hẳn route lại.
DEV_SIMULATE_SECRET=your_random_dev_secret
